# Copiá este archivo como .env.local y completá los valores.
# En Vercel cargalos en Settings → Environment Variables.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Clave secreta: SOLO en el servidor. Se usa para la sincronización automática.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Tu API del banco (scraping) ---
# URL que devuelve saldo y movimientos. Ver lib/sync/banco.js para ajustar el formato.
BANK_API_URL=https://tu-api.ejemplo.com/movimientos
# Opcional: si tu API pide una clave, se manda como "Authorization: Bearer ..."
BANK_API_KEY=

# --- Mercado Pago (Developers → Tus integraciones → Credenciales de producción) ---
# Dejalo vacío si no usan Mercado Pago.
MP_ACCESS_TOKEN=

# --- Sincronización automática ---
# Cualquier texto largo y aleatorio. Vercel lo usa para llamar a /api/sync.
CRON_SECRET=cambiame-por-algo-largo-y-aleatorio
